# ==========================================
# Backend API Configuration
# ==========================================
EXPO_PUBLIC_API_URL="http://your-local-ip:3000/api"
# For production: "https://yourdomain.com/api"

# ==========================================
# Authentication (Google OAuth)
# ==========================================
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""

# ==========================================
# Force OTA Update Restart
# ==========================================
# Set to "true" to force the app to restart immediately upon downloading an OTA update.
EXPO_PUBLIC_FORCE_OTA_UPDATE="false"

# ==========================================
# Sentry (Error Monitoring & Session Replays)
# ==========================================
# Get this from: https://sentry.io → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN="your_sentry_dsn_here"
